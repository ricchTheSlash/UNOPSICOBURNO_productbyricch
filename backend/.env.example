# =============================================================================
# CGH SaaS — variáveis de ambiente. Copie para `.env` e preencha.
# NUNCA commite o .env.
# =============================================================================

# --- Banco --------------------------------------------------------------------
# Connection string do Postgres. Aceita os 3 formatos comuns:
#   postgresql://user:pass@host:5432/db          (padrão psql / Supabase)
#   postgres://user:pass@host:5432/db            (alias antigo / Heroku)
#   postgresql+asyncpg://user:pass@host:5432/db  (nativo SQLAlchemy)
DATABASE_URL=postgresql://postgres:senha@db.xxxxxxxxxxxx.supabase.co:5432/postgres


# --- Asaas --------------------------------------------------------------------
# Em desenvolvimento, use a chave do SANDBOX, nunca a de produção.
ASAAS_API_KEY=coloque_sua_chave_de_sandbox_aqui
ASAAS_BASE_URL=https://sandbox.asaas.com/api
# Em produção: https://api.asaas.com


# --- App ----------------------------------------------------------------------
APP_ENV=development


# --- JWT ----------------------------------------------------------------------
# Segredo de assinatura dos JWTs. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use um valor DIFERENTE por ambiente (dev/staging/prod) e NUNCA commite.
JWT_SECRET_KEY=cole_aqui_um_segredo_longo_e_aleatorio
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7


# --- Convites -----------------------------------------------------------------
INVITE_EXPIRATION_HOURS=48


# --- CORS ---------------------------------------------------------------------
# Lista de origens permitidas, separadas por vírgula.
# Em dev (Vite): http://localhost:5173
# Em prod: https://app.seudominio.com.br
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
